# Copy to .env and fill in real values. Every key is required; there are no defaults.
# Never commit .env.

# Async SQLAlchemy URL for PostgreSQL with pgvector (psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:<port>/<database>

# Embedding vector size, a whole number from 1 to 2000. Fixed in the database
# when migrations run; changing it later needs a new migration.
EMBEDDING_DIMENSION=<dimension>

# One of: development, test, production
APP_ENV=<app-env>

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=<log-level>

# --- Ingestion (M2) ---

# Absolute path to an existing, writable folder OUTSIDE this repository.
# Original uploads are stored here.
UPLOAD_DIR=<absolute-path-outside-repo>

# Largest accepted upload, in bytes (a whole number, at least 1).
MAX_UPLOAD_BYTES=<bytes>

# Largest accepted PDF, in pages (a whole number, at least 1).
MAX_PAGES=<pages>

# Comma-separated category names accepted on upload, e.g. IT,HR,Facilities
SOP_CATEGORIES=<category-1>,<category-2>

# Only "openai" is supported in M2.
EMBEDDING_PROVIDER=<provider>

# OpenAI embedding model name, e.g. text-embedding-3-small
EMBEDDING_MODEL=<model>

# Secret. Never commit a real key.
OPENAI_API_KEY=<openai-api-key>

# Texts per embeddings request (1 to 2048).
EMBEDDING_BATCH_SIZE=<batch-size>

# One of: heading, fixed
CHUNKING_STRATEGY=<strategy>

# Chunk size and overlap, in tokens. Overlap must be less than the maximum.
CHUNK_MAX_TOKENS=<max-tokens>
CHUNK_OVERLAP_TOKENS=<overlap-tokens>

# A tiktoken encoding name, e.g. cl100k_base
TOKENIZER_ENCODING=<encoding>
