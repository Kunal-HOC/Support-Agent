# Copy to .env and fill in real values. Every key is required; there are no defaults.
# Never commit .env.

# Async SQLAlchemy URL for PostgreSQL with pgvector (psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:<port>/<database>

# Embedding vector size, a whole number from 1 to 2000. Fixed in the database
# when migrations run; changing it later needs a new migration.
EMBEDDING_DIMENSION=<dimension>

# One of: development, test, production
APP_ENV=<app-env>

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=<log-level>
